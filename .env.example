# ─────────────────────────────────────────────────────────────────────────────
# .env — copy this to .env and fill in your values
# NEVER commit .env to Git
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL: Supabase or any external Postgres URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# PRODUCTION only (used by docker-compose.prod.yml to spin up local Postgres)
POSTGRES_DB=repricer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank — docker-compose sets REDIS_URL=redis://redis:6379 automatically
# Only set this if you're running Node.js outside Docker pointing at the container
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret

# ── Python Scraper ────────────────────────────────────────────────────────────
# Leave blank — docker-compose sets PYTHON_SCRAPER_URL automatically
# Only set if running Node.js outside Docker
PYTHON_SCRAPER_URL=http://localhost:8000

# Comma-separated proxy list in format: ip:port:username:password
SCRAPER_PROXIES=31.59.20.176:6754:user:pass,45.38.107.97:6014:user:pass

# UK delivery postcode for location-specific Amazon pricing
DELIVERY_POSTCODE=M1 1AE

# Anthropic API key — enables Claude Vision fallback (optional)
ANTHROPIC_API_KEY=

# Scraper concurrency and delays
SCRAPER_WORKERS=3
SCRAPER_DELAY_MIN=1
SCRAPER_DELAY_MAX=3

# ── OnBuy ─────────────────────────────────────────────────────────────────────
ONBUY_CONSUMER_KEY=your_consumer_key_here
ONBUY_SECRET_KEY=your_secret_key_here
ONBUY_SITE_ID=2000
